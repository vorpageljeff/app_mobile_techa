{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://techa-api.2.25.189.129.nip.io/api/$1"
    },
    {
      "source": "/backend-ready",
      "destination": "https://techa-api.2.25.189.129.nip.io/ready"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
